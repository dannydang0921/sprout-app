# Environment Variables for Sprout App
# Copy this file to .env and fill in the values

# Application Settings
PORT=3001
NODE_ENV=development

# Database (SQLite)
# No additional config needed for SQLite

# Session Security
SESSION_SECRET=your_session_secret_here_change_in_production

# CORS Settings
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Storage
# STORAGE_TYPE can be 'local', 's3', or 'cloudinary'
STORAGE_TYPE=local
UPLOADS_DIR=uploads

# Cloudinary Settings (required when STORAGE_TYPE=cloudinary)
# Get these from your Cloudinary account dashboard
CLOUDINARY_CLOUD_NAME=your_actual_cloud_name_here
CLOUDINARY_API_KEY=your_actual_api_key_here
CLOUDINARY_API_SECRET=your_actual_api_secret_here

# AWS S3 Settings (required when STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_S3_REGION=your_s3_region